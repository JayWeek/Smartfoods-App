	font-size: 2.2rem;
	font-weight: 800;
	letter-spacing: -0.02em;
	animation: sf-scale-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

.sf-welcome-hero-banner p {
	margin: 0;
	font-size: 1.05rem;
	color: rgba(255, 255, 255, 0.88);
	line-height: 1.5;
}

/* Summary Panels Metrics Flex Row Styles */
.sf-summary-metric-row {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 1.25rem;
}

.sf-summary-metric-tile {
	background: rgba(255, 255, 255, 0.6);
	border: 1px solid rgba(124, 77, 255, 0.08);
	border-radius: 14px;
	padding: 1.25rem;
	text-align: center;
	transition: var(--sf-transition-smooth);
}

.sf-summary-metric-tile:hover {
	background: #ffffff;
	border-color: rgba(124, 77, 255, 0.2);
	transform: scale(1.02);
}

.sf-summary-metric-tile span {
	font-size: 0.72rem;
	font-weight: 750;
	color: var(--sf-text-muted);
	text-transform: uppercase;
	letter-spacing: 0.05em;
	display: block;
	margin-bottom: 0.5rem;
}

.sf-summary-metric-tile strong {
	font-size: 2.2rem;
	font-weight: 850;
	color: var(--sf-purple-dark);
	display: block;
	line-height: 1;
	animation: sf-number-bump 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

/* Form Controls & Styling Elements */
.sf-premium-form-layout {
	display: flex;
	flex-direction: column;
	gap: 1.1rem;
}

.sf-form-double-column {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 1rem;
}

.sf-form-field-block {
	display: flex;
	flex-direction: column;
	gap: 0.45rem;
}

.sf-form-field-block label {
	font-size: 0.82rem;
	font-weight: 700;
	color: var(--sf-purple-dark);
}

.sf-form-input-element {
	width: 100%;
	padding: 0.8rem 1rem;
	border: 1px solid rgba(124, 77, 255, 0.2);
	border-radius: 10px;
	background: white;
	color: var(--sf-text-main);
	font-size: 0.92rem;
	outline: none;
	transition: var(--sf-transition-smooth);
}

.sf-form-input-element:focus {
	border-color: var(--sf-purple-primary);
	box-shadow: 0 0 0 4px rgba(124, 77, 255, 0.12);
}

.sf-action-submit-button {
	width: 100%;
	padding: 0.9rem;
	border: none;
	border-radius: 10px;
	background: var(--sf-accent-gradient);
	color: white;
	font-weight: 750;
	font-size: 0.95rem;
	cursor: pointer;
	box-shadow: 0 6px 16px rgba(124, 77, 255, 0.2);
	transition: var(--sf-transition-smooth);
}

.sf-action-submit-button:hover:not(:disabled) {
	box-shadow: 0 10px 24px rgba(124, 77, 255, 0.35);
	transform: translateY(-1px);
}

.sf-action-submit-button:disabled {
	opacity: 0.6;
	cursor: not-allowed;
}

/* Premium Lists and Feed Item Cards Styles */
.sf-list-group-wrapper {
	display: flex;
	flex-direction: column;
	gap: 0.75rem;
}

.sf-list-entry-item {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 0.9rem 1.1rem;
	background: rgba(255, 255, 255, 0.5);
	border: 1px solid rgba(124, 77, 255, 0.06);
	border-radius: 12px;
	transition: var(--sf-transition-smooth);
}

.sf-list-entry-item:hover {
	background: white;
	border-color: rgba(124, 77, 255, 0.2);
}

.sf-list-entry-title-text {
	font-weight: 650;
	font-size: 0.95rem;
	color: var(--sf-text-main);
}

.sf-list-entry-meta-text {
	font-size: 0.78rem;
	color: var(--sf-text-muted);
	margin-top: 0.2rem;
}

.sf-pill-badge {
	padding: 0.35rem 0.75rem;
	border-radius: 20px;
	font-size: 0.75rem;
	font-weight: 750;
	background: var(--sf-purple-light);
	color: var(--sf-purple-dark);
}

.sf-pill-badge.danger-theme {
	background: #ffebee;
	color: #c62828;
}

/* Category Charts Distributions Visualization Bar Elements */
.sf-category-chart-row-container {
	display: flex;
	flex-direction: column;
	gap: 1.1rem;
}

.sf-chart-row-header {
	display: flex;
	justify-content: space-between;
	font-size: 0.88rem;
	font-weight: 600;
}

.sf-chart-bar-rail {
	width: 100%;
	height: 10px;
	background: var(--sf-purple-light);
	border-radius: 6px;
	overflow: hidden;
}

.sf-chart-bar-fill {
	height: 100%;
	background: var(--sf-accent-gradient);
	border-radius: 6px;
	transition: width 1s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Smart Meal Ideas Dynamic Cards Grids layout */
.sf-meals-recipe-grid {
	display: grid;
	grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
	gap: 1.25rem;
}

.sf-meal-recipe-card {
	background: white;
	border: 1px solid var(--sf-card-border);
	border-radius: 12px;
	overflow: hidden;
	display: flex;
	flex-direction: column;
	transition: var(--sf-transition-smooth);
}

.sf-meal-recipe-card:hover {
	transform: scale(1.03) translateY(-2px);
	box-shadow: var(--sf-shadow-premium);
}

.sf-meal-recipe-card img {
	width: 100%;
	height: 110px;
	object-fit: cover;
}

.sf-meal-recipe-details {
	padding: 1rem;
	display: flex;
	flex-direction: column;
	flex: 1;
	gap: 0.5rem;
}

.sf-meal-recipe-details h4 {
	margin: 0;
	font-size: 0.95rem;
	color: var(--sf-purple-dark);
	line-height: 1.3;
}

.sf-meal-recipe-details p {
	margin: 0;
	font-size: 0.78rem;
	color: #c62828;
	font-weight: 600;
}

.sf-recipe-link-anchor {
	margin-top: auto;
	display: block;
	width: 100%;
	text-align: center;
	padding: 0.55rem;
	background: var(--sf-purple-light);
	color: var(--sf-purple-dark);
	text-decoration: none;
	font-weight: 750;
	font-size: 0.8rem;
	border-radius: 8px;
	transition: var(--sf-transition-smooth);
}

.sf-recipe-link-anchor:hover {
	background: var(--sf-purple-primary);
	color: white;
}

.sf-empty-state-notice {
	border: 2px dashed rgba(124, 77, 255, 0.2);
	border-radius: 12px;
	padding: 1.5rem;
	text-align: center;
	color: var(--sf-text-muted);
	font-size: 0.88rem;
}

.sf-alert-banner {
	padding: 0.8rem 1rem;
	border-radius: 10px;
	font-size: 0.88rem;
	font-weight: 600;
	margin-bottom: 1rem;
}

.sf-alert-banner.success-mode {
	background: #e8f5e9;
	color: #2e7d32;
}

.sf-alert-banner.error-mode {
	background: #ffebee;
	color: #c62828;
}

/* --- CSS Visual Presentation System Animations --- */
@keyframes sf-fade-up {
	from {
		opacity: 0;
		transform: translateY(20px);
	}

	to {
		opacity: 1;
		transform: translateY(0);
	}
}

@keyframes sf-fade-down {
	from {
		opacity: 0;
		transform: translateY(-15px);
	}

	to {
		opacity: 1;
		transform: translateY(0);
	}
}

@keyframes sf-scale-in {
	from {
		opacity: 0;
		transform: scale(0.95);
	}

	to {
		opacity: 1;
		transform: scale(1);
	}
}

@keyframes sf-number-bump {
	0% {
		transform: scale(0.8);
		opacity: 0;
	}

	50% {
		transform: scale(1.1);
	}

	100% {
		transform: scale(1);
		opacity: 1;
	}
}

/* --- Responsive Tablet and Mobile Breakpoint Queries --- */
@media (max-width: 1024px) {
	.sf-dashboard-grid-layout {
		grid-template-columns: 1fr;
		gap: 1.75rem;
	}
}

@media (max-width: 768px) {
	.sf-mobile-top-bar {
		display: flex;
	}

	.sf-left-sidebar {
		position: fixed;
		top: 70px;
		left: -100%;
		width: 280px;
		height: calc(100vh - 70px);
		z-index: 105;
		box-shadow: 15px 0 30px rgba(0, 0, 0, 0.05);
	}

	.sf-left-sidebar.mobile-open {
		left: 0;
	}

	.sf-right-content-pane {
		padding: 6.5rem 1.25rem 2rem 1.25rem;
	}

	.sf-summary-metric-row {
		grid-template-columns: 1fr;
		gap: 1rem;
	}
}



/* =========================================================
   DASHBOARD SKELETONS
========================================================= */

.sf-skeleton-card {
    position: relative;
    overflow: hidden;
}

.sf-skeleton-title,
.sf-skeleton-text,
.sf-skeleton-value,
.sf-skeleton-label,
.sf-skeleton-chart-label,
.sf-skeleton-chart-bar,
.sf-skeleton-image,
.sf-skeleton-list-content,
.sf-skeleton-pill {
    position: relative;
    overflow: hidden;
    background: #eceff3;
    border-radius: 12px;
}

.sf-skeleton-title {
    height: 30px;
    width: 50%;
    margin-bottom: 1rem;
}

.sf-skeleton-text {
    height: 14px;
    width: 100%;
    margin-bottom: 0.75rem;
}

.sf-skeleton-text.short {
    width: 65%;
}

.sf-skeleton-value {
    height: 42px;
    width: 100%;
    margin-bottom: 0.75rem;
}

.sf-skeleton-label {
    height: 12px;
    width: 70%;
    margin: 0 auto;
}

.sf-skeleton-chart-row {
    margin-top: 1rem;
}

.sf-skeleton-chart-label {
    height: 14px;
    width: 35%;
    margin-bottom: 0.5rem;
}

.sf-skeleton-chart-bar {
    height: 12px;
    width: 100%;
    border-radius: 999px;
}

.sf-skeleton-recipe-grid {
    display: grid;
    gap: 1rem;
}

.sf-skeleton-recipe-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.sf-skeleton-image {
    width: 100%;
    height: 180px;
    border-radius: 16px;
}

.sf-skeleton-list-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 1rem;
}

.sf-skeleton-list-content {
    flex: 1;
    height: 44px;
}

.sf-skeleton-pill {
    width: 100px;
    height: 32px;
    border-radius: 999px;
}

.sf-skeleton-title::after,
.sf-skeleton-text::after,
.sf-skeleton-value::after,
.sf-skeleton-label::after,
.sf-skeleton-chart-label::after,
.sf-skeleton-chart-bar::after,
.sf-skeleton-image::after,
.sf-skeleton-list-content::after,
.sf-skeleton-pill::after {
    content: "";
    position: absolute;
    inset: 0;
    transform: translateX(-100%);
    background:
        linear-gradient(
            90deg,
            transparent,
            rgba(255,255,255,0.8),
            transparent);
    animation: sf-skeleton-shimmer 1.25s infinite;
}

@keyframes sf-skeleton-shimmer {
    100% {
        transform: translateX(100%);
    }
}
