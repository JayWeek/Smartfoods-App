<file path="Components/Pages/Dashboard/Dashboard.razor">
@page "/dashboard"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using SmartFoods.Web.Models.Identity

@attribute [Authorize]

@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Dashboard</PageTitle>

@if (IsLoading)
{
    <p>Loading...</p>
}
else
{
    <WelcomePanel @key="_welcomePanelVersion" UserId="@CurrentUserId" />

    <QuickAddPanel UserId="@CurrentUserId" OnItemAdded="HandleItemAdded" />
}

@code {

    private Guid CurrentUserId;

    private bool IsLoading = true;

    private int _welcomePanelVersion;

    protected override async Task OnInitializedAsync()
    {
        var authState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        var user =
            await UserManager.GetUserAsync(
                authState.User);

        if (user is null)
        {
            return;
        }

        CurrentUserId = user.Id;

        IsLoading = false;
    }

    private Task HandleItemAdded()
    {
        _welcomePanelVersion++;

        return Task.CompletedTask;
    }
}
</file>

