        {
            <span>Adding...</span>
        }
        else
        {
            <span>Add Item</span>
        }
    </button>

</EditForm>

@code {

    [Parameter]
    public Guid UserId { get; set; }

    [Parameter]
    public EventCallback OnItemAdded { get; set; }

    private CreateFoodItemDto Model = new();

    private string? SuccessMessage;

    private string? ErrorMessage;

    private bool IsSubmitting;

    private async Task HandleSubmit()
    {
        try
        {
            IsSubmitting = true;

            await DashboardService
                .AddFoodItemAsync(
                    UserId,
                    Model);

            SuccessMessage =
                $"{Model.Name} added successfully.";

            ErrorMessage = null;

            Model = new CreateFoodItemDto();

            await OnItemAdded.InvokeAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
            SuccessMessage = null;
        }
        finally
        {
            IsSubmitting = false;
        }
    }
}
