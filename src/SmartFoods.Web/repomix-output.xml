        using var dbContext = await DbContextFactory.CreateDbContextAsync();

        // Securely fetch single message trace item
        LogItem = await dbContext.NotificationLogs
            .AsNoTracking()
            .FirstOrDefaultAsync(n => n.Id == Id);

        IsLoading = false;
    }
}
