@* Components/Pages/Dashboard/Dashboard.razor *@
@page "/dashboard"
@layout DashboardLayout

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using SmartFoods.Web.Models.DTOs.Dashboard
@using SmartFoods.Web.Models.Identity
@using SmartFoods.Web.Services.Dashboard

@using SmartFoods.Web.Components.Pages.Dashboard.Skeletons

@attribute [Authorize]
@attribute [StreamRendering]

@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDashboardService DashboardService

<PageTitle>Dashboard - SmartFoods</PageTitle>

<div class="sf-dashboard-grid-layout">

    <div class="sf-dashboard-column-stack">

        @if (_dashboardData is null)
        {
            <WelcomeSkeleton />
            <SummarySkeleton />
            <ChartSkeleton />
            <RecipeSkeleton />
        }
        else
        {
            <WelcomePanel Model="_dashboardData.Welcome" />

            <PantrySummaryPanel
                Model="_dashboardData.PantrySummary" />

            <CategoryChartPanel
                Model="_dashboardData.CategoryChart" />

            <SmartSuggestionsPanel
                Model="_dashboardData.SmartSuggestions" />
        }

    </div>

    <div class="sf-dashboard-column-stack">

        <QuickAddPanel UserId="@CurrentUserId"
                       OnItemAdded="HandleItemAdded" />

        @if (_dashboardData is null)
        {
            <AttentionSkeleton />
            <ActivitySkeleton />
        }
        else
        {
            <AttentionRequiredPanel
                Model="_dashboardData.AttentionRequired" />

            <RecentActivityPanel
                Model="_dashboardData.RecentActivity" />
        }

    </div>

</div>

@code {

    private Guid CurrentUserId;

    private DashboardOverviewDto? _dashboardData;

    protected override async Task OnInitializedAsync()
    {
        var authState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        var user =
            await UserManager.GetUserAsync(authState.User);

        if (user is not null)
        {
            CurrentUserId = user.Id;

            _dashboardData =
                await DashboardService
                    .GetDashboardOverviewAsync(CurrentUserId);
        }
    }

    private async Task HandleItemAdded()
    {
        _dashboardData =
            await DashboardService
                .GetDashboardOverviewAsync(CurrentUserId);

        await InvokeAsync(StateHasChanged);
    }

}
