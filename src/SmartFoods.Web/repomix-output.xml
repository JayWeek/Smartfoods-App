<file path="Components/Pages/Dashboard/NotificationsPanel.razor">
@* Components/Pages/Dashboard/NotificationsPanel.razor *@
@using SmartFoods.Web.Data
@using Microsoft.EntityFrameworkCore
@using SmartFoods.Web.Models.Pantry

@inject IDbContextFactory<ApplicationDbContext> DbContextFactory

<h3>Recent Notifications</h3>

@if (IsLoading)
{
    <p>Loading notification archives...</p>
}
else if (Logs != null)
{
    @if (!Logs.Any())
    {
        <div style="border: 1px dashed #ccc; padding: 15px; margin-bottom: 20px;">
            <p><strong>Your inbox is clear.</strong></p>
            <p>Historical reminders, daily expiration logs, and recipe recommendation alerts will register right here once items near their deadlines.</p>
        </div>
    }
    else
    {
        <div style="display: flex; flex-direction: column; gap: 15px; margin-bottom: 20px;">
            @foreach (var log in Logs)
            {
                <div style="border: 1px solid #ccc; padding: 15px; border-radius: 4px; background-color: #fff; display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <div style="font-size: 12px; color: #666; margin-bottom: 4px;">
                            📅 <strong>@log.NotificationDate.ToString("d")</strong>
                        </div>
                        <h4 style="margin: 0; font-size: 16px; color: #333;">@log.Title</h4>
                    </div>
                    
                    @* Action link to our new dedicated detail path *@
                    <a href="/notifications/@log.Id" style="display: inline-block; padding: 6px 12px; background-color: #007bff; color: white; text-decoration: none; border-radius: 4px; font-size: 13px; font-weight: bold;">
                        Read Message →
                    </a>
                </div>
            }
        </div>
    }
}

@code {
    [Parameter]
    public Guid UserId { get; set; }

    private List<NotificationLog>? Logs;
    private bool IsLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;
        using var dbContext = await DbContextFactory.CreateDbContextAsync();

        // Extract latest 10 alerts delivered to this specific user profile
        Logs = await dbContext.NotificationLogs
            .AsNoTracking()
            .Where(n => n.UserId == UserId)
            .OrderByDescending(n => n.NotificationDate)
            .Take(10)
            .ToListAsync();

        IsLoading = false;
    }
}
</file>

