    border-radius: 999px;
    background: linear-gradient(135deg, var(--sf-purple), var(--sf-teal));
    box-shadow: 0 0 0 0.35rem rgba(111, 76, 255, 0.08);
}

.sf-sidebar-footer {
    margin-top: auto;
    padding: 1rem;
    border: 1px solid var(--sf-line);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.68);
}

.sf-sidebar-footer p {
    margin: 0 0 0.85rem;
    color: var(--sf-muted);
    font-size: 0.82rem;
    line-height: 1.45;
}

.sf-main {
    min-width: 0;
    padding: 1.5rem;
}

.sf-main-inner {
    width: min(100%, 76rem);
    margin: 0 auto;
}

.sf-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
}

.sf-kicker {
    margin: 0 0 0.25rem;
    color: var(--sf-purple-dark);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.sf-page-title {
    margin: 0;
    font-size: clamp(1.55rem, 3vw, 2.4rem);
    line-height: 1.05;
}

.sf-subtitle {
    margin: 0.45rem 0 0;
    color: var(--sf-muted);
    line-height: 1.6;
}

.sf-dashboard-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(21rem, 0.95fr);
    gap: 1rem;
    align-items: start;
}

.sf-stack {
    display: grid;
    gap: 1rem;
}

.sf-card {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--sf-line);
    border-radius: 1rem;
    background: var(--sf-card);
    box-shadow: var(--sf-shadow-sm);
    backdrop-filter: blur(14px);
    animation: sf-rise 420ms ease both;
}

.sf-card::before {
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    content: "";
    background: linear-gradient(90deg, var(--sf-purple), var(--sf-teal), var(--sf-lavender));
    opacity: 0.82;
}

.sf-card-body {
    padding: 1.2rem;
}

.sf-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
}

.sf-card-title {
    margin: 0;
    font-size: 1rem;
    line-height: 1.25;
}

.sf-card-note {
    margin: 0.25rem 0 0;
    color: var(--sf-muted);
    font-size: 0.88rem;
    line-height: 1.5;
}

.sf-hero {
    border: 0;
    color: white;
    background:
        linear-gradient(135deg, rgba(111, 76, 255, 0.96), rgba(64, 34, 184, 0.9) 54%, rgba(32, 199, 168, 0.86));
    box-shadow: 0 26px 80px rgba(64, 34, 184, 0.22);
}

.sf-hero::before {
    display: none;
}

.sf-hero .sf-card-body {
    padding: 1.5rem;
}

.sf-hero h1 {
    max-width: 42rem;
    margin: 0;
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1.02;
}

.sf-hero p {
    max-width: 42rem;
    margin: 0.9rem 0 0;
    color: rgba(255, 255, 255, 0.84);
    line-height: 1.65;
}

.sf-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
}

.sf-metric {
    min-height: 7.25rem;
    padding: 1rem;
    border: 1px solid rgba(111, 76, 255, 0.12);
    border-radius: 0.9rem;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(250, 247, 255, 0.82));
}

.sf-metric span {
    color: var(--sf-muted);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
}

.sf-metric strong {
    display: block;
    margin-top: 0.45rem;
    font-size: 2rem;
    line-height: 1;
}

.sf-metric p {
    margin: 0.45rem 0 0;
    color: var(--sf-muted);
    font-size: 0.84rem;
}

.sf-form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
}

.sf-field {
    display: grid;
    gap: 0.4rem;
}

.sf-field label {
    color: #352a4c;
    font-size: 0.82rem;
    font-weight: 750;
}

.sf-input {
    width: 100%;
    min-height: 2.85rem;
    padding: 0.72rem 0.85rem;
    border: 1px solid rgba(111, 76, 255, 0.18);
    border-radius: 0.75rem;
    color: var(--sf-ink);
    background: rgba(255, 255, 255, 0.86);
    outline: none;
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
}

.sf-input:focus {
    border-color: rgba(111, 76, 255, 0.56);
    box-shadow: 0 0 0 4px rgba(111, 76, 255, 0.12);
}

.sf-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.85rem;
    padding: 0.72rem 1rem;
    border: 0;
    border-radius: 0.75rem;
    color: white;
    background: linear-gradient(135deg, var(--sf-purple), var(--sf-purple-dark));
    box-shadow: 0 16px 30px rgba(111, 76, 255, 0.24);
    cursor: pointer;
    font-weight: 800;
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease, opacity 180ms ease;
}

.sf-button:hover {
    transform: translateY(-1px);
    box-shadow: 0 20px 36px rgba(111, 76, 255, 0.28);
}

.sf-button:disabled {
    cursor: progress;
    opacity: 0.68;
}

.sf-button.secondary {
    color: var(--sf-purple-dark);
    background: rgba(255, 255, 255, 0.82);
    box-shadow: none;
    border: 1px solid rgba(111, 76, 255, 0.18);
}

.sf-alert {
    margin: 0 0 0.85rem;
    padding: 0.8rem 0.9rem;
    border-radius: 0.75rem;
    font-size: 0.9rem;
}

.sf-alert.success {
    color: #066451;
    background: rgba(32, 199, 168, 0.12);
}

.sf-alert.error {
    color: #9f1239;
    background: rgba(244, 63, 94, 0.1);
}

.validation-errors {
    margin: 0 0 0.85rem;
    padding: 0.8rem 0.9rem;
    border-radius: 0.75rem;
    color: #9f1239;
    background: rgba(244, 63, 94, 0.1);
}

.sf-empty {
    padding: 1rem;
    border: 1px dashed rgba(111, 76, 255, 0.28);
    border-radius: 0.9rem;
    color: var(--sf-muted);
    background: rgba(255, 255, 255, 0.52);
}

.sf-empty strong {
    display: block;
    margin-bottom: 0.3rem;
    color: var(--sf-ink);
}

.sf-list {
    display: grid;
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
}

.sf-list-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.9rem;
    padding: 0.82rem;
    border: 1px solid rgba(111, 76, 255, 0.1);
    border-radius: 0.8rem;
    background: rgba(255, 255, 255, 0.7);
}

.sf-item-main {
    min-width: 0;
}

.sf-item-main strong {
    display: block;
}

.sf-item-meta {
    color: var(--sf-muted);
    font-size: 0.82rem;
}

.sf-pill {
    flex: 0 0 auto;
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    color: var(--sf-purple-dark);
    background: rgba(111, 76, 255, 0.1);
    font-size: 0.78rem;
    font-weight: 800;
}

.sf-pill.danger {
    color: #9f1239;
    background: rgba(244, 63, 94, 0.1);
}

.sf-status-good {
    color: #066451;
}

.sf-chart-wrap {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: 1.25rem;
    align-items: center;
}

.sf-pie {
    width: min(13rem, 100%);
    aspect-ratio: 1;
    border-radius: 999px;
    background: var(--sf-pie-gradient);
    box-shadow: inset 0 0 0 1px rgba(111, 76, 255, 0.14), 0 22px 45px rgba(64, 34, 184, 0.16);
}

.sf-pie-core {
    display: grid;
    width: 55%;
    height: 55%;
    place-items: center;
    margin: 22.5%;
    border-radius: 999px;
    text-align: center;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: inset 0 0 0 1px rgba(111, 76, 255, 0.12);
}

.sf-pie-core strong {
    display: block;
    font-size: 1.65rem;
}

.sf-pie-core span {
    color: var(--sf-muted);
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
}

.sf-legend {
    display: grid;
    gap: 0.65rem;
}

.sf-legend-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.6rem;
    align-items: center;
}

.sf-swatch {
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 999px;
    background: var(--swatch);
}

.sf-recipe-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 0.85rem;
}

.sf-recipe-card {
    display: flex;
    min-height: 17rem;
    overflow: hidden;
    border: 1px solid rgba(111, 76, 255, 0.12);
    border-radius: 0.9rem;
    background: rgba(255, 255, 255, 0.78);
    flex-direction: column;
}

.sf-recipe-card img {
    width: 100%;
    height: 8.5rem;
    object-fit: cover;
}

.sf-recipe-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.7rem;
    padding: 0.85rem;
}

.sf-recipe-body h4 {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.35;
}

.sf-recipe-body p {
    margin: 0;
    color: #9f1239;
    font-size: 0.8rem;
    font-weight: 750;
}

.sf-recipe-body .sf-button {
    margin-top: auto;
}

.sf-skeleton-card {
    border: 1px solid var(--sf-line);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.72);
    box-shadow: var(--sf-shadow-sm);
    padding: 1.2rem;
}

.sf-skeleton-line,
.sf-skeleton-block,
.sf-skeleton-circle {
    position: relative;
    overflow: hidden;
    background: linear-gradient(90deg, rgba(111, 76, 255, 0.08), rgba(255, 255, 255, 0.86), rgba(111, 76, 255, 0.08));
    background-size: 220% 100%;
    animation: sf-shimmer 1.25s linear infinite;
}

.sf-skeleton-line {
    height: 0.85rem;
    margin-bottom: 0.65rem;
    border-radius: 999px;
}

.sf-skeleton-line.short {
    width: 45%;
}

.sf-skeleton-line.medium {
    width: 70%;
}

.sf-skeleton-block {
    height: 5.5rem;
    border-radius: 0.9rem;
}

.sf-skeleton-circle {
    width: 10rem;
    aspect-ratio: 1;
    border-radius: 999px;
}

@keyframes sf-shimmer {
    to {
        background-position: -220% 0;
    }
}

@keyframes sf-rise {
    from {
        opacity: 0;
        transform: translateY(8px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@media (max-width: 980px) {
    .sf-dashboard {
        grid-template-columns: 1fr;
    }

    .sf-sidebar {
        position: static;
        height: auto;
        padding: 0.85rem;
    }

    .sf-sidebar-inner {
        gap: 0.85rem;
    }

    .sf-nav {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .sf-sidebar-footer {
        display: none;
    }

    .sf-dashboard-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 700px) {
    .sf-main {
        padding: 0.85rem;
    }

    .sf-topbar,
    .sf-card-header,
    .sf-list-item {
        align-items: stretch;
        flex-direction: column;
    }

    .sf-nav {
        grid-template-columns: 1fr;
    }

    .sf-metrics,
    .sf-form-grid,
    .sf-chart-wrap {
        grid-template-columns: 1fr;
    }

    .sf-pie,
    .sf-skeleton-circle {
        margin-inline: auto;
    }
}
