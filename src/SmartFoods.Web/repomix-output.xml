:root {
	--sf-bg-gradient: linear-gradient(135deg, #ffffff 0%, #fcfbfe 45%, #f5efff 100%);
	--sf-purple-primary: #7c4dff;
	--sf-purple-light: #f3e5f5;
	--sf-purple-dark: #4a148c;
