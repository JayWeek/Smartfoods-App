@using SmartFoods.Web.Models.DTOs.Dashboard
@using SmartFoods.Web.Services.Dashboard

@inject IDashboardService DashboardService

<h2>Quick Add Food Item</h2>

@if (!string.IsNullOrWhiteSpace(SuccessMessage))
{
    <p>@SuccessMessage</p>
}

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <p>@ErrorMessage</p>
}

<EditForm
    Model="Model"
    OnValidSubmit="HandleSubmit">

    <DataAnnotationsValidator />
    <ValidationSummary />

    <div>
        <label>Name</label>
        <InputText @bind-Value="Model.Name" />
    </div>

    <div>
        <label>Quantity</label>
        <InputNumber @bind-Value="Model.Quantity" />
    </div>

    <div>
        <label>Unit</label>

        <InputSelect @bind-Value="Model.Unit">
            <option value="">Select Unit</option>
            <option>Kg</option>
            <option>Grams</option>
            <option>Litres</option>
            <option>Millilitres</option>
            <option>Pieces</option>
            <option>Packets</option>
        </InputSelect>
    </div>

    <div>
        <label>Category</label>

        <InputSelect @bind-Value="Model.Category">
            <option value="">Select Category</option>
            <option>Dairy</option>
            <option>Vegetables</option>
            <option>Fruit</option>
            <option>Meat</option>
            <option>Grains</option>
            <option>Beverages</option>
            <option>Other</option>
        </InputSelect>
    </div>

    <div>
        <label>Expiry Date</label>

        <InputDate @bind-Value="Model.ExpiryDate" />
    </div>

    <button type="submit" disabled="@IsSubmitting">
