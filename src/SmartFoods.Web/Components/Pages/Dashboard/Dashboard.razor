@* Components/Pages/Dashboard/Dashboard.razor *@
@page "/dashboard"
@layout DashboardLayout
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using SmartFoods.Web.Models.DTOs.Dashboard
@using SmartFoods.Web.Models.Identity
@using SmartFoods.Web.Services.Dashboard

@using SmartFoods.Web.Components.Pages.Dashboard.Skeletons

@attribute [Authorize]

@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDashboardService DashboardService
@inject DashboardStateHub StateHub
@implements IDisposable

<PageTitle>SmartFoods - Dashboard</PageTitle>

<div class="sf-dashboard-grid-layout">

    <div class="sf-dashboard-column-stack">

        @if (_dashboardData is null)
        {
            <WelcomeSkeleton />
            <SummarySkeleton />
            <ChartSkeleton />
            <RecipeSkeleton />
        }
        else
        {
            <WelcomePanel Model="_dashboardData.Welcome" />

            <PantrySummaryPanel Model="_dashboardData.PantrySummary" />

            <CategoryChartPanel Model="_dashboardData.CategoryChart" />

            <SmartSuggestionsPanel Model="_dashboardData.SmartSuggestions" />
        }

    </div>

    <div class="sf-dashboard-column-stack">

        <QuickAddPanel UserId="@CurrentUserId"
                       OnItemAdded="HandleItemAdded" />

        @if (_dashboardData is null)
        {
            <AttentionSkeleton />
            <ActivitySkeleton />
        }
        else
        {
            <AttentionRequiredPanel
                Model="_dashboardData.AttentionRequired"
                UserId="@CurrentUserId"
                OnActionCompleted="HandleItemAdded" />

            <RecentActivityPanel Model="_dashboardData.RecentActivity" />
        }

    </div>

</div>

@code {
    private Guid CurrentUserId;
    private DashboardOverviewDto? _dashboardData;

    protected override async Task OnInitializedAsync()
    {
        // Register the real-time hub listener
        StateHub.OnDashboardChanged += HandleStateHubBroadcast;

        // OPTIMIZATION 1: Extract User ID directly from Claims Principal token (Zero DB latency)
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (Guid.TryParse(userIdClaim, out var parsedGuid))
        {
            CurrentUserId = parsedGuid;

            // OPTIMIZATION 2: Non-blocking execution loop.
            // Kicking this task off without an 'await' keyword forces OnInitializedAsync 
            // to return immediately. The skeletons will paint on screen instantly.
            _ = LoadDashboardDataBackgroundAsync();
        }
        else
        {
            // Fallback safe measure if claim schema varies
            var user = await UserManager.GetUserAsync(authState.User);
            if (user is not null)
            {
                CurrentUserId = user.Id;
                _ = LoadDashboardDataBackgroundAsync();
            }
        }
    }

    private async Task LoadDashboardDataBackgroundAsync()
    {
        try
        {
            _dashboardData = await DashboardService.GetDashboardOverviewAsync(CurrentUserId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Dashboard Background Data Flight Failure]: {ex.Message}");
        }
        finally
        {
            // Forces Blazor to swap the skeletons out for the premium panels seamlessly
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleItemAdded()
    {
        await RefreshGlobalDashboardDataAsync();
    }

    private async void HandleStateHubBroadcast()
    {
        try
        {
            await RefreshGlobalDashboardDataAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Global Orchestrator Broadcast Fault]: {ex.Message}");
        }
    }

    private async Task RefreshGlobalDashboardDataAsync()
    {
        _dashboardData = await DashboardService.GetDashboardOverviewAsync(CurrentUserId);
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        StateHub.OnDashboardChanged -= HandleStateHubBroadcast;
    }
}