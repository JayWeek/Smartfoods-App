@page "/dashboard"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using SmartFoods.Web.Models.Identity

@attribute [Authorize]

@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Dashboard</PageTitle>

@if (IsLoading)
{
    <p>Loading...</p>
}
else
{
    @* Wrapping siblings in a single keyed container forces a safe cascade update *@
    <div @key="_dashboardVersion">
        @* Feature 1: Welcome Panel *@
        <WelcomePanel UserId="@CurrentUserId" />

        @* Feature 2: Quick Add Area *@
        <QuickAddPanel UserId="@CurrentUserId" OnItemAdded="HandleItemAdded" />

        @* Feature 3: Pantry Summary Cards *@
        <PantrySummaryPanel UserId="@CurrentUserId" />

        @* Feature 4: Attention Required List *@
        <AttentionRequiredPanel UserId="@CurrentUserId" />

        @* Feature 5: Category Breakdown Chart *@
        <CategoryChartPanel UserId="@CurrentUserId" />

        @* Feature 6: Recent Activity List *@
        <RecentActivityPanel UserId="@CurrentUserId" />

        @* Feature 7: Smart Suggestions Panel *@
        <SmartSuggestionsPanel UserId="@CurrentUserId" />
    </div>
}

@code {
    private Guid CurrentUserId;
    private bool IsLoading = true;
    private int _dashboardVersion;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user is null)
        {
            return;
        }

        CurrentUserId = user.Id;
        IsLoading = false;
    }

    private Task HandleItemAdded()
    {
        _dashboardVersion++;
        return Task.CompletedTask;
    }
}
