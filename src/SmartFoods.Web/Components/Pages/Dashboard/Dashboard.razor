@* Components/Pages/Dashboard/Dashboard.razor *@
@page "/dashboard"
@layout DashboardLayout
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using SmartFoods.Web.Models.DTOs.Dashboard
@using SmartFoods.Web.Models.Identity
@using SmartFoods.Web.Services.Dashboard

@using SmartFoods.Web.Components.Pages.Dashboard.Skeletons

@attribute [Authorize]

@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDashboardService DashboardService
@inject DashboardStateHub StateHub
@implements IDisposable

<PageTitle>Dashboard - SmartFoods</PageTitle>

<div class="sf-dashboard-grid-layout">

    <div class="sf-dashboard-column-stack">

        @if (_dashboardData is null)
        {
            <WelcomeSkeleton />
            <SummarySkeleton />
            <ChartSkeleton />
            <RecipeSkeleton />
        }
        else
        {
            <WelcomePanel Model="_dashboardData.Welcome" />

            <PantrySummaryPanel Model="_dashboardData.PantrySummary" />

            <CategoryChartPanel Model="_dashboardData.CategoryChart" />

            <SmartSuggestionsPanel Model="_dashboardData.SmartSuggestions" />
        }

    </div>

    <div class="sf-dashboard-column-stack">

        <QuickAddPanel UserId="@CurrentUserId"
                       OnItemAdded="HandleItemAdded" />

        @if (_dashboardData is null)
        {
            <AttentionSkeleton />
            <ActivitySkeleton />
        }
        else
        {
            <AttentionRequiredPanel
                Model="_dashboardData.AttentionRequired"
                UserId="@CurrentUserId"
                OnActionCompleted="HandleItemAdded" />

            <RecentActivityPanel Model="_dashboardData.RecentActivity" />
        }

    </div>

</div>

@code {
    private Guid CurrentUserId;
    private DashboardOverviewDto? _dashboardData;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user is not null)
        {
            CurrentUserId = user.Id;
            
            // Initial asynchronous load
            await RefreshGlobalDashboardDataAsync();
        }

        // REGISTER THE GLOBAL REAL-TIME HUD LISTENER HERE
        StateHub.OnDashboardChanged += HandleStateHubBroadcast;
    }

    private async Task HandleItemAdded()
    {
        await RefreshGlobalDashboardDataAsync();
    }

    private async void HandleStateHubBroadcast()
    {
        try
        {
            // When ANY panel raises a change signal, re-fetch everything centrally
            await RefreshGlobalDashboardDataAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Global Orchestrator Broadcast Fault]: {ex.Message}");
        }
    }

    private async Task RefreshGlobalDashboardDataAsync()
    {
        _dashboardData = await DashboardService.GetDashboardOverviewAsync(CurrentUserId);
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        // Explicit teardown prevents memory leaks on navigation tracking lines
        StateHub.OnDashboardChanged -= HandleStateHubBroadcast;
    }
}
