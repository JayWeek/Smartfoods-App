@* Components/Pages/Dashboard/Dashboard.razor *@
@page "/dashboard"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using SmartFoods.Web.Models.Identity

@attribute [Authorize]

@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Dashboard - SmartFoods</PageTitle>

@if (IsLoading)
{
    <DashboardSkeleton />
}
else
{
    <div class="sf-dashboard-grid-layout" @key="_dashboardVersion">
        <!-- Left Dashboard Stack: Hero Welcome Banner, Summaries, and suggestions -->
        <div class="sf-dashboard-column-stack">
            <WelcomePanel UserId="@CurrentUserId" />
            <PantrySummaryPanel UserId="@CurrentUserId" />
            <CategoryChartPanel UserId="@CurrentUserId" />
            <SmartSuggestionsPanel UserId="@CurrentUserId" />
        </div>

        <!-- Right Dashboard Stack: Input Controls and Expiry Reminders Lists -->
        <div class="sf-dashboard-column-stack">
            <QuickAddPanel UserId="@CurrentUserId" OnItemAdded="HandleItemAdded" />
            <AttentionRequiredPanel UserId="@CurrentUserId" />
            <RecentActivityPanel UserId="@CurrentUserId" />
        </div>
    </div>
}

@code {
    private Guid CurrentUserId;
    private bool IsLoading = true;
    private int _dashboardVersion;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user is not null)
        {
            CurrentUserId = user.Id;
        }

        IsLoading = false;
    }

    private Task HandleItemAdded()
    {
        _dashboardVersion++;
        return Task.CompletedTask;
    }
}
