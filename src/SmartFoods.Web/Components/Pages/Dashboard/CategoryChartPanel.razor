@using SmartFoods.Web.Models.DTOs.Dashboard
@using SmartFoods.Web.Services.Dashboard

@inject IDashboardService DashboardService

<h3>Food Categories Distribution</h3>

@if (IsLoading)
{
    <p>Calculating category volumes...</p>
}
else if (Model is not null)
{
    @if (Model.IsEmptyPantry)
    {
        <div style="border: 1px dashed #ccc; padding: 15px; margin-bottom: 20px;">
            <p><strong>No category distribution available.</strong></p>
            <p>Distribution metrics (e.g., Dairy, Vegetables, Meat) will appear here as a breakdown chart once items populate your pantry profile.</p>
        </div>
    }
    else
    {
        <div style="border: 1px solid #aaa; padding: 15px; margin-bottom: 20px; max-width: 500px;">
            <p style="margin-top: 0; color: #555;">Distribution of pantry items by category.</p>
            
            @foreach (var cat in Model.Categories)
            {
                <div style="margin-bottom: 12px;">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
                        <span><strong>@cat.CategoryName</strong> (@cat.ItemCount items)</span>
                        <span>@cat.Percentage%</span>
                    </div>
                    <!-- Proportional bar rendering -->
                    <div style="background-color: #eee; width: 100%; height: 14px; border-radius: 3px; overflow: hidden;">
                        <div style="background-color: #4682b4; width: @(cat.Percentage)%; height: 100%;"></div>
                    </div>
                </div>
            }
        </div>
    }
}

@code {
    [Parameter]
    public Guid UserId { get; set; }

    private CategoryChartDto? Model;
    private bool IsLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;
        Model = await DashboardService.GetCategoryChartAsync(UserId);
        IsLoading = false;
    }
}
