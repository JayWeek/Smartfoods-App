@* Components/Pages/Dashboard/NotificationsPanel.razor *@
@using SmartFoods.Web.Data
@using Microsoft.EntityFrameworkCore
@using SmartFoods.Web.Models.Pantry

@inject IDbContextFactory<ApplicationDbContext> DbContextFactory

<div class="sf-premium-card">
    <h3 class="sf-card-header-title">Historical Reminder Trace Logs</h3>
    <p class="sf-card-header-subtitle">Review up to the latest 10 automated email deliveries executed across your account line.</p>

    @if (IsLoading)
    {
        <div class="sf-empty-state-notice">Streaming notification logs...</div>
    }
    else if (Logs != null)
    {
        @if (!Logs.Any())
        {
            <div class="sf-empty-state-notice" style="padding: 3rem 1.5rem;">
                <div style="font-size: 2rem; margin-bottom: 0.5rem;">📥</div>
                <strong>Your reminder box is clean</strong>
                <p style="margin: 0.25rem 0 0 0; font-size: 0.82rem; color: var(--sf-text-muted);">Daily critical expiry notifications will catalogue here once items trigger tracking limits.</p>
            </div>
        }
        else
        {
            <div class="sf-list-group-wrapper">
                @foreach (var log in Logs)
                {
                    <div class="sf-list-entry-item" style="background: rgba(255, 255, 255, 0.85); border-color: rgba(124, 77, 255, 0.08);">
                        <div>
                            <div style="font-size: 0.75rem; font-weight: 750; color: var(--sf-purple-primary); margin-bottom: 0.25rem;">
                                📅 DELIVERED @log.NotificationDate.ToString("D").ToUpper()
                            </div>
                            <div class="sf-list-entry-title-text" style="font-size: 1.05rem; color: var(--sf-purple-dark);">@log.Title</div>
                        </div>
                        <a href="/notifications/@log.Id" class="sf-recipe-link-anchor" style="margin-top: 0; width: auto; padding: 0.6rem 1.2rem;">
                            Read Message →
                        </a>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public Guid UserId { get; set; }
    private List<NotificationLog>? Logs;
    private bool IsLoading = true;
    private Guid _previousUserId;

    protected override void OnParametersSet()
    {
        // Only trigger query execution if UserId is bound and has transitioned to a new value
        if (UserId != Guid.Empty && UserId != _previousUserId)
        {
            _previousUserId = UserId;
            IsLoading = true;

            // OPTIMIZATION: Non-blocking execution loop. 
            // Running this background task unawaited allows the UI thread to instantly render 
            // the panel and its native streaming loading message without navigation lag.
            _ = LoadNotificationLogsBackgroundAsync();
        }
    }

    private async Task LoadNotificationLogsBackgroundAsync()
    {
        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();

            Logs = await dbContext.NotificationLogs
                .AsNoTracking()
                .Where(n => n.UserId == UserId)
                .OrderByDescending(n => n.NotificationDate)
                .Take(10)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Notifications Panel Background Flight Failure]: {ex.Message}");
        }
        finally
        {
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}