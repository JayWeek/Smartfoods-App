@using SmartFoods.Web.Models.DTOs.Dashboard
@using SmartFoods.Web.Services.Dashboard

@inject IDashboardService DashboardService

<h3>Pantry Summary</h3>

@if (IsLoading)
{
    <p>Loading summary...</p>
}
else if (Model is not null)
{
    @if (Model.IsEmptyPantry)
    {
        <div style="border: 1px dashed #ccc; padding: 15px; margin-bottom: 20px;">
            <p><strong>No items tracked yet.</strong></p>
            <p>Once you add grocery items, summary breakdown cards (Total Items, Categories, and Expiring Status) will populate here instantly.</p>
        </div>
    }
    else
    {
        <div style="display: flex; gap: 20px; margin-bottom: 20px;">
            <!-- Card 1: Total Items -->
            <div style="border: 1px solid #aaa; padding: 15px; min-width: 150px;">
                <h4>Total Items</h4>
                <p style="font-size: 24px; font-weight: bold; margin: 5px 0;">@Model.TotalFoodItems</p>
                <small>Items in Pantry</small>
            </div>

            <!-- Card 2: Expiring Soon -->
            <div style="border: 1px solid #aaa; padding: 15px; min-width: 150px;">
                <h4>Expiring Soon</h4>
                <p style="font-size: 24px; font-weight: bold; margin: 5px 0; color: #b22222;">@Model.ExpiringSoonCount</p>
                <small>Expiring Within 7 Days</small>
            </div>

            <!-- Card 3: Categories -->
            <div style="border: 1px solid #aaa; padding: 15px; min-width: 150px;">
                <h4>Categories</h4>
                <p style="font-size: 24px; font-weight: bold; margin: 5px 0;">@Model.TotalCategories</p>
                <small>Food Categories</small>
            </div>
        </div>
    }
}

@code {
    [Parameter]
    public Guid UserId { get; set; }

    private PantrySummaryDto? Model;
    private bool IsLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;
        Model = await DashboardService.GetPantrySummaryAsync(UserId);
        IsLoading = false;
    }
}
