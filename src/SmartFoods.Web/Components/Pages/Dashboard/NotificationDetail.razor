@* Components/Pages/Dashboard/NotificationDetail.razor *@
@page "/notifications/{Id:guid}"
@rendermode InteractiveServer

@using SmartFoods.Web.Data
@using Microsoft.EntityFrameworkCore
@using SmartFoods.Web.Models.Pantry
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory

<PageTitle>System Alert Trace Payload - SmartFoods</PageTitle>

<div style="margin-bottom: 1.5rem;">
    <a href="/dashboard/notifications" class="sf-recipe-link-anchor" style="display: inline-block; width: auto; padding: 0.5rem 1rem;">
        ← Back to Notifications Feed
    </a>
</div>

@if (IsLoading)
{
    <div class="sf-empty-state-notice">Decrypting secure communication packet...</div>
}
else if (LogItem is null)
{
    <div class="sf-premium-card" style="border-color: rgba(198, 40, 40, 0.15);">
        <div class="sf-alert-banner error-mode">⚠ Record Archive Error</div>
        <p style="margin: 0; color: var(--sf-text-muted);">The requested unique reference trace could not be identified inside the database ledger tables.</p>
    </div>
}
else
{
    <div class="sf-premium-card" style="max-width: 750px; animation: sf-fade-up 0.4s ease both;">
        <div style="border-bottom: 1px solid var(--sf-card-border); padding-bottom: 1rem; margin-bottom: 1.5rem;">
            <span style="font-size: 0.8rem; font-weight: 700; color: var(--sf-text-muted);">Sent tracking archive timestamp: @LogItem.SentAt.ToLocalTime().ToString("f")</span>
            <h2 style="margin: 0.5rem 0 0 0; font-size: 1.6rem; font-weight: 850; color: var(--sf-purple-dark); line-height: 1.2;">@LogItem.Title</h2>
        </div>

        @* Renders the safe HTML payload message compiled by your Hangfire background worker *@
        <div style="line-height: 1.7; color: var(--sf-text-main); font-size: 0.98rem; background: #ffffff; padding: 1.5rem; border-radius: 8px; border: 1px solid rgba(124, 77, 255, 0.05);">
            @((MarkupString)LogItem.MessageBody)
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private NotificationLog? LogItem;
    private bool IsLoading = true;

    protected override async Task OnInitializedAsync()
    {
        using var dbContext = await DbContextFactory.CreateDbContextAsync();
        LogItem = await dbContext.NotificationLogs
            .AsNoTracking()
            .FirstOrDefaultAsync(n => n.Id == Id);

        IsLoading = false;
    }
}
