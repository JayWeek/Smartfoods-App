@* Components/Pages/Dashboard/QuickAddPanel.razor *@
@rendermode InteractiveServer
@using SmartFoods.Web.Models.DTOs.Dashboard
@using SmartFoods.Web.Services.Dashboard

@inject IDashboardService DashboardService
@inject DashboardStateHub StateHub

<div class="sf-premium-card">
    <h3 class="sf-card-header-title">Quick Add Supply Item</h3>
    <p class="sf-card-header-subtitle">Record new grocery stock balances instantly into the database ledger lines.</p>

    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <div class="sf-alert-banner success-mode">✓ @SuccessMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="sf-alert-banner error-mode">⚠ @ErrorMessage</div>
    }

    <EditForm Model="Model" FormName="QuickAddFoodForm" OnValidSubmit="HandleSubmit" class="sf-premium-form-layout">
        <DataAnnotationsValidator />

        <div class="sf-form-field-block">
            <label>Item Name</label>
            <InputText @bind-Value="Model.Name" class="sf-form-input-element" placeholder="e.g., Whole Organic Milk" />
        </div>

        <div class="sf-form-double-column">
            <div class="sf-form-field-block">
                <label>Quantity</label>
                <InputNumber TValue="decimal" Value="@Model.Quantity" ValueChanged="@(value => Model.Quantity = value)" ValueExpression="@(() => Model.Quantity)" class="sf-form-input-element" placeholder="0" step="0.01" />
            </div>

            <div class="sf-form-field-block">
                <label>Measurement Unit</label>
                <InputSelect @bind-Value="Model.Unit" class="sf-form-input-element">
                    <option value="">Select Unit</option>
                    <option value="Kg">Kg</option>
                    <option value="Grams">Grams</option>
                    <option value="Litres">Litres</option>
                    <option value="Pieces">Pieces</option>
                    <option value="Packets">Packets</option>
                </InputSelect>
            </div>
        </div>

        <div class="sf-form-double-column">
            <div class="sf-form-field-block">
                <label>Food Category</label>
                <InputSelect @bind-Value="Model.Category" class="sf-form-input-element">
                    <option value="">Select Category</option>
                    <option value="Dairy">Dairy</option>
                    <option value="Vegetables">Vegetables</option>
                    <option value="Fruit">Fruit</option>
                    <option value="Meat">Meat</option>
                    <option value="Grains">Grains</option>
                    <option value="Beverages">Beverages</option>
                    <option value="Other">Other</option>
                </InputSelect>
            </div>

            <div class="sf-form-field-block">
                <label>Expiration Date</label>
                <InputDate @bind-Value="Model.ExpiryDate" class="sf-form-input-element" />
            </div>
        </div>

        <button type="submit" class="sf-action-submit-button" style="margin-top: 0.5rem;" disabled="@IsSubmitting">
            @(IsSubmitting ? "Saving to Database Ledger..." : "Add Item to Pantry")
        </button>
    </EditForm>
</div>

@code {
    [Parameter] public Guid UserId { get; set; }
    [Parameter] public EventCallback OnItemAdded { get; set; }

    [SupplyParameterFromForm(FormName = "QuickAddFoodForm")]
    private CreateFoodItemDto Model { get; set; } = new() { ExpiryDate = DateOnly.FromDateTime(DateTime.UtcNow.AddDays(7)) };

    private string? SuccessMessage;
    private string? ErrorMessage;
    private bool IsSubmitting;

    private async Task HandleSubmit()
    {
        try
        {
            IsSubmitting = true;
            await DashboardService.AddFoodItemAsync(UserId, Model);
            SuccessMessage = $"{Model.Name} successfully catalogued.";
            ErrorMessage = null;
            
            // Reset the form model safely in memory bounds
            Model = new CreateFoodItemDto { ExpiryDate = DateOnly.FromDateTime(DateTime.UtcNow.AddDays(7)) };
            
            // BROADCAST THE UPDATE THROUGH THE REAL-TIME STATE SYNC CIRCUITS
            StateHub.NotifyStateChanged();

            // Fire structural backwards compatibility delegates to notify root layout templates
            if (OnItemAdded.HasDelegate)
            {
                await OnItemAdded.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
            SuccessMessage = null;
        }
        finally
        {
            IsSubmitting = false;
        }
    }
}
