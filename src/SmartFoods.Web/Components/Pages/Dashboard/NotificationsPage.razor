@* Components/Pages/Dashboard/NotificationsPage.razor *@
@page "/dashboard/notifications"
@layout DashboardLayout
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using SmartFoods.Web.Models.Identity

@attribute [Authorize]

@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>SmartFoods - Alerts</PageTitle>

@* OPTIMIZATION: Removed the blocking loading conditional wrapper so the layout paints instantly *@
<div class="sf-dashboard-grid-layout" style="grid-template-columns: 1fr;">
    <div class="sf-premium-card sf-welcome-hero-banner" style="background: linear-gradient(135deg, #311b92 0%, #7c4dff 100%);">
        <h1>System Notifications Archive</h1>
        <p>Historical reminder delivery logs tracking expired shelf-life items and daily kitchen recipe matching routines.</p>
    </div>

    <NotificationsPanel UserId="@CurrentUserId" />
</div>

@code {
    private Guid CurrentUserId;

    protected override async Task OnInitializedAsync()
    {
        // OPTIMIZATION: Extract User ID directly from Claims Principal token (Zero DB latency)
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (Guid.TryParse(userIdClaim, out var parsedGuid))
        {
            CurrentUserId = parsedGuid;
        }
        else
        {
            // Fallback safe measure if claim schema varies
            var user = await UserManager.GetUserAsync(authState.User);
            if (user is not null)
            {
                CurrentUserId = user.Id;
            }
        }
    }
}