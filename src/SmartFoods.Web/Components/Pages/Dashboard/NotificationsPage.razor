@* Components/Pages/Dashboard/NotificationsPage.razor *@
@page "/dashboard/notifications"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using SmartFoods.Web.Models.Identity

@attribute [Authorize]

@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Alerts Archive Feed - SmartFoods</PageTitle>

@if (IsLoading)
{
    <div class="sf-empty-state-notice">Verifying profile session metrics...</div>
}
else
{
    <div class="sf-dashboard-grid-layout" style="grid-template-columns: 1fr;">
        <div class="sf-premium-card sf-welcome-hero-banner" style="background: linear-gradient(135deg, #311b92 0%, #7c4dff 100%);">
            <h1>System Notifications Archive</h1>
            <p>Historical reminder delivery logs tracking expired shelf-life items and daily kitchen recipe matching routines.</p>
        </div>

        <NotificationsPanel UserId="@CurrentUserId" />
    </div>
}

@code {
    private Guid CurrentUserId;
    private bool IsLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user is not null)
        {
            CurrentUserId = user.Id;
        }
        IsLoading = false;
    }
}
