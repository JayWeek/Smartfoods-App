@using SmartFoods.Web.Models.DTOs.Dashboard
@using SmartFoods.Web.Services.Dashboard

@inject IDashboardService DashboardService

<h3>Smart Meal Suggestions</h3>

@if (IsLoading)
{
    <p>Generating matching recipe recommendations...</p>
}
else if (Model is not null)
{
    @if (Model.IsEmptyState)
    {
        <div style="border: 1px dashed #ccc; padding: 15px; margin-bottom: 20px;">
            <p><strong>No suggestions yet.</strong></p>
            <p>Once you add tracking items that are nearing their expiration deadlines, our integration engine will automatically surface meal inspirations utilizing those specific food supplies.</p>
        </div>
    }
    else
    {
        <div style="border: 1px solid #aaa; padding: 15px; margin-bottom: 20px; background-color: #fafafa;">
            <p style="margin-top: 0; color: #555;">Based on items in your pantry needing attention soonest, consider trying these recipes:</p>
            
            <div style="display: flex; gap: 20px; flex-wrap: wrap;">
                @foreach (var rec in Model.Suggestions)
                {
                    <div style="border: 1px solid #ccc; background: #fff; padding: 10px; width: 220px; border-radius: 4px; display: flex; flex-direction: column; justify-content: space-between;">
                        <div>
                            @if (!string.IsNullOrWhiteSpace(rec.ImageUrl))
                            {
                                <img src="@rec.ImageUrl" alt="@rec.Title" style="width: 100%; height: 120px; object-fit: cover; border-radius: 2px; margin-bottom: 8px;" />
                            }
                            <h4 style="margin: 0 0 6px 0; font-size: 16px;">@rec.Title</h4>
                            <p style="margin: 0 0 10px 0; font-size: 12px; color: #b22222; font-weight: bold;">
                                💡 Uses your expiring <u>@rec.TargetIngredient</u>
                            </p>
                        </div>
                        <a href="@rec.SourceUrl" target="_blank" style="display: inline-block; padding: 6px; background-color: #007bff; color: white; text-align: center; text-decoration: none; border-radius: 3px; font-size: 13px; font-weight: bold;">
                            View Recipe
                        </a>
                    </div>
                }
            </div>
        </div>
    }
}

@code {
    [Parameter]
    public Guid UserId { get; set; }

    private SmartSuggestionsDto? Model;
    private bool IsLoading = true;

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;
        Model = await DashboardService.GetSmartSuggestionsAsync(UserId);
        IsLoading = false;
    }
}
