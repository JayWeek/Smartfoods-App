@* src/SmartFoods.Web/Components/Pages/Auth/Login.razor *@
@page "/login"

@using SmartFoods.Web.Models.DTOs
@using SmartFoods.Web.Services.Interfaces
@using Microsoft.AspNetCore.Components.Authorization

@inject IAuthService AuthService
@inject NavigationManager Navigation

<h3>Login</h3>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <p style="color:red">@ErrorMessage</p>
}

<EditForm Model="Model" OnValidSubmit="ExecuteLogin" FormName="LoginForm" method="post">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div>
        <label>Email</label>
        <InputText @bind-Value="Model.Email" type="email" />
    </div>

    <div>
        <label>Password</label>
        <InputText type="password" @bind-Value="Model.Password" />
    </div>

    <button type="submit">
        Login
    </button>
</EditForm>

@code {
    [SupplyParameterFromForm]
    private LoginDto Model { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? ErrorMessage;

    private async Task ExecuteLogin()
    {
        var success = await AuthService.LoginAsync(Model);

        if (success)
        {
            Navigation.NavigateTo(
                string.IsNullOrWhiteSpace(ReturnUrl)
                    ? "/dashboard"
                    : ReturnUrl,
                forceLoad: true);

            return;
        }

        ErrorMessage = "Invalid email or password.";
    }
}
