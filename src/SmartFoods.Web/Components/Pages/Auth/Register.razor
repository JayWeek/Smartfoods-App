@* src/SmartFoods.Web/Components/Pages/Auth/Register.razor *@
@page "/register"

@using SmartFoods.Web.Models.DTOs
@using SmartFoods.Web.Services.Interfaces

@inject IAuthService AuthService
@inject NavigationManager Navigation

<h3>Register</h3>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <p style="color:red">@ErrorMessage</p>
}

<EditForm Model="Model" OnValidSubmit="ExecuteRegister" FormName="RegisterForm" method="post">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div>
        <label>Name</label>
        <InputText @bind-Value="Model.Name" />
    </div>

    <div>
        <label>Email</label>
        <InputText @bind-Value="Model.Email" type="email" />
    </div>

    <div>
        <label>Password</label>
        <InputText type="password" @bind-Value="Model.Password" />
    </div>

    <div>
        <label>Confirm Password</label>
        <InputText type="password" @bind-Value="Model.ConfirmPassword" />
    </div>

    <button type="submit">
        Register
    </button>
</EditForm>

@code {
    [SupplyParameterFromForm]
    private RegisterDto Model { get; set; } = new();

    private string? ErrorMessage;

    private async Task ExecuteRegister()
    {
        var result = await AuthService.RegisterAsync(Model);

        if (result.Success)
        {
            Navigation.NavigateTo("/login", forceLoad: true);
            return;
        }

        ErrorMessage = string.Join(", ", result.Errors);
    }
}
